@page "/accommodations"

@using BookMyHome.Client.Models
@using BookMyHome.Client.Services

@inject AccommodationService AccommodationService

<h1>Accommodations</h1>

<a href="/accommodations/create"
   class="btn btn-primary mb-4">
    Create Accommodation
</a>

@if (accommodations == null)
{
    <p>Loading...</p>
}
else if (accommodations.Count == 0)
{
    <p>No accommodations found.</p>
}
else
{
    <div class="row">

        @foreach (var accommodation in accommodations)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <a href="@($"/accommodations/{accommodation.AccommodationId}")"
                       style="text-decoration: none; color: inherit;">

                        @if (accommodation.Images.Any())
                        {
                            <img src="@accommodation.Images.First().ImageUrl"
                                 class="card-img-top"
                                 alt="@accommodation.Name"
                                 style="height: 230px;
                            object-fit: cover;" />
                        }

                        <div class="card-body">

                            <h4 class="card-title">
                                @accommodation.Name
                            </h4>

                            <p class="card-text">
                                @accommodation.Address
                            </p>

                            <h5>
                                @accommodation.PricePerNight kr. / night
                            </h5>

                        </div>

                    </a>

                    <div class="card-footer">

                        <a class="btn btn-warning"
                           href="@($"/accommodations/edit/{accommodation.AccommodationId}")">
                            Edit
                        </a>

                        <button class="btn btn-danger"
                                @onclick="() => DeleteAccommodation(accommodation.AccommodationId)">
                            Delete
                        </button>

                    </div>

                </div>

            </div>
        }

    </div>
}

@code {
    private List<AccommodationDto>? accommodations;

    protected override async Task OnInitializedAsync()
    {
        accommodations =
            await AccommodationService.GetAllAsync();
    }

    private async Task DeleteAccommodation(Guid id)
    {
        await AccommodationService.DeleteAsync(id);

        accommodations =
            await AccommodationService.GetAllAsync();
    }
}